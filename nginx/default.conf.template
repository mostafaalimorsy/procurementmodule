# Rendered at container start by the nginx image (envsubst over defined variables only). Every product
# host serves the same Angular artifact; PRODUCT_CONTEXT selects which product's entry routes it owns.
include /etc/nginx/product/locale-map.conf;

# Re-audit R-01 (ADR-168): the one production topology is TLS ingress -> these web hosts -> API. The ingress terminates TLS, sets
# X-Forwarded-For and X-Forwarded-Proto, and is the only peer these hosts accept traffic from. From that network (and only from it) the
# client's address is taken from X-Forwarded-For — so the per-client bidder budget below is per client, not one budget for everyone — and
# the ingress's scheme is passed to the API instead of this host's plain http. TRUSTED_INGRESS_CIDR defaults to loopback (local
# development: no ingress, nothing trusted).
set_real_ip_from ${TRUSTED_INGRESS_CIDR};
real_ip_header X-Forwarded-For;
geo $realip_remote_addr $from_ingress {
    default 0;
    ${TRUSTED_INGRESS_CIDR} 1;
}
map "$from_ingress:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "1:https" https;
}

# Per-client budget for the anonymous tender-invitation API (used by the workspace host only). The API behind
# this proxy sees one address for everyone, so the per-client limit lives here; the API keeps a global ceiling.
limit_req_zone $binary_remote_addr zone=tender_invitations:10m rate=60r/m;

server {
    listen 8080;
    server_name _;
    set $workspace_origin "${WORKSPACE_PUBLIC_ORIGIN}";
    set $platform_origin "${PLATFORM_PUBLIC_ORIGIN}";
    include /etc/nginx/product/common.conf;
    include /etc/nginx/product/${PRODUCT_CONTEXT}.conf;
}
